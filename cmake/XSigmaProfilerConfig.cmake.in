@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_xsigma_profiler_lib "${PACKAGE_PREFIX_DIR}/lib/@PROFILER_IMPORTED_LIB@")
if(NOT EXISTS "${_xsigma_profiler_lib}")
  set(_xsigma_profiler_lib "${PACKAGE_PREFIX_DIR}/bin/@PROFILER_IMPORTED_LIB@")
endif()

if(NOT TARGET Profiler::Profiler)
  add_library(Profiler::Profiler SHARED IMPORTED)
  set_target_properties(
    Profiler::Profiler
    PROPERTIES IMPORTED_LOCATION "${_xsigma_profiler_lib}"
               INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
  )
endif()

if(NOT TARGET XSigmaProfiler::Profiler)
  add_library(XSigmaProfiler::Profiler ALIAS Profiler::Profiler)
endif()

check_required_components(XSigmaProfiler)
