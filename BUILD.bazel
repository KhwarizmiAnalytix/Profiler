# =============================================================================
# Profiler library (matches CMakeLists.txt backend splits)
# =============================================================================
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load("//bazel:profiler.bzl", "profiler_copts", "profiler_defines", "profiler_linkopts")

package(default_visibility = ["//visibility:public"])

# KINETO backend: bespoke/base, bespoke/kineto, bespoke/common (no unwind)
_KINETO_BACKEND_SRCS = glob(
    [
        "src/kineto_*.cpp",
        "src/kineto/**/*.cpp",
        "src/bespoke/kineto/**/*.cpp",
        "src/bespoke/common/**/*.cpp",
        "src/bespoke/base/**/*.cpp",
    ],
    exclude = [
        "src/bespoke/common/unwind/**/*.cpp",
        "Testing/**",
    ],
    allow_empty = True,
)

# ITT backend (when PROFILER_ENABLE_ITT and not KINETO): base + common + itt.
# include/bespoke/kineto/kineto_shim.{h,cpp} is included even though this isn't the Kineto backend:
# include/bespoke/common/collection.{h,cpp} #include "bespoke/kineto/kineto_shim.h" unconditionally
# (matches CMakeLists.txt).
# profiler_kineto.{h,cpp} is also included: it is the shared enableProfiler/
# disableProfiler orchestration layer for every backend (Kineto, ITT, NVTX,
# PRIVATEUSE1), not just Kineto -- its ITT dispatch branch is internally
# guarded by #if PROFILER_HAS_ITT and does not touch libkineto.
# kineto_client_interface.* is Kineto-ondemand-only (its body is wholly
# `#if PROFILER_HAS_KINETO`) but is harmlessly inert without it.
_ITT_BACKEND_SRCS = glob(
    [
        "src/bespoke/base/**/*.cpp",
        "src/bespoke/common/**/*.cpp",
        "src/bespoke/itt/**/*.cpp",
        "src/bespoke/kineto/kineto_shim.cpp",
        "src/bespoke/kineto/profiler_kineto.cpp",
        "src/bespoke/kineto/kineto_client_interface.cpp",
    ],
    exclude = [
        "src/bespoke/common/unwind/**/*.cpp",
        "Testing/**",
    ],
    allow_empty = True,
)

_KINETO_BACKEND_HDRS = glob(
    [
        "include/kineto_*.h",
        "include/kineto/**/*.h",
        "include/bespoke/kineto/**/*.h",
        "include/bespoke/common/**/*.h",
        "include/bespoke/base/**/*.h",
    ],
    exclude = ["Testing/**"],
    allow_empty = True,
)

_ITT_BACKEND_HDRS = glob(
    [
        "include/bespoke/base/**/*.h",
        "include/bespoke/common/**/*.h",
        "include/bespoke/itt/**/*.h",
        "include/bespoke/kineto/kineto_shim.h",
        "include/bespoke/kineto/profiler_kineto.h",
        "include/bespoke/kineto/kineto_client_interface.h",
    ],
    exclude = ["Testing/**"],
    allow_empty = True,
)

filegroup(
    name = "profiler_hdrs",
    srcs = glob(
        [
            "include/*.h",
            "include/**/*.h",
        ],
        exclude = [
            "Testing/**",
            "include/native/**",
            "include/bespoke/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "profiler_srcs",
    srcs = glob(
        [
            "src/*.cpp",
            "src/common/**/*.cpp",
        ],
        exclude = [
            "src/bespoke/**",
            "src/kineto_*.cpp",
            "src/kineto/**/*.cpp",
            "Testing/**",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "Profiler",
    srcs = [
        ":profiler_srcs",
    ] + glob(["src/native/**/*.cpp"], exclude = ["Testing/**"], allow_empty = True) + select({
        "//bazel:enable_itt": _ITT_BACKEND_SRCS,
        "//conditions:default": _KINETO_BACKEND_SRCS,
    }),
    hdrs = [
        ":profiler_hdrs",
    ] + glob(["include/native/**/*.h", "include/native/**/*.hxx"], exclude = ["Testing/**"], allow_empty = True) + select({
        "//bazel:enable_itt": _ITT_BACKEND_HDRS,
        "//conditions:default": _KINETO_BACKEND_HDRS,
    }),
    copts = profiler_copts(),
    defines = profiler_defines() + select({
        "//bazel:shared_libs": ["PROFILER_SHARED_DEFINE", "PROFILER_BUILDING_DLL"],
        "//conditions:default": ["PROFILER_STATIC_DEFINE"],
    }),
    includes = [
        "include",
    ],
    linkopts = profiler_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    deps = [
        "@fmt//:fmt",
    ] + select({
        "//bazel:enable_itt": ["@ittapi//:ittnotify"],
        "//conditions:default": ["@kineto//:kineto"],
    }) + select({
        "//bazel:enable_cuda": ["@local_config_cuda//:cuda"],
        "//conditions:default": [],
    }) + select({
        "//bazel:enable_hip": ["@local_config_hip//:hip"],
        "//conditions:default": [],
    }),
    # native/core/profiler_factory.h's registered profilers (host_tracer_factory,
    # python_tracer_factory, gpu_tracer_factory) and the
    # bespoke stub registrations (cuda.cpp's RegisterCUDAOrHIPMethods, itt.cpp's
    # RegisterITTMethods) self-register via static-init -- no other code references
    # a symbol in those translation units. Bazel links this target as a static
    # archive (see linkstatic above); without alwayslink, the linker drops those
    # objects and the corresponding tracing/backend capability never starts, with
    # no error (reproduced locally via a minimal consumer linked against a static
    # build with no force-link: capture succeeded but produced an empty trace).
    # CMake's shared-library build doesn't hit this since every object file in a
    # .so is linked; CMake's static build has the equivalent fix in
    # cmake/ProfilerLinking.cmake's profiler_keep_static_registrations().
    alwayslink = True,
)

# =============================================================================
# Install / export (bazel-side analogue of CMake's curated
# `install(FILES ...)` header allowlist / `install(TARGETS Profiler ...)`
# in CMakeLists.txt around lines 382-436). Profiler deliberately installs
# only a narrow, hand-curated set of public headers -- the transitive
# #include closure of profiler.h -- rather than every header under
# include/ (most of include/native and include/bespoke are implementation
# detail). This list is kept in sync with CMakeLists.txt's
# _profiler_public_headers.
# `bazel build //:profiler_pkg_tar` produces a relocatable tarball; `bazel
# run //:install -- --destdir=/some/prefix` stages the same tree directly
# on disk.
# =============================================================================

pkg_files(
    name = "profiler_installed_hdrs",
    srcs = [
        "include/profiler.h",
        "include/common/align_of.h",
        "include/common/annotation.h",
        "include/common/approximate_clock.h",
        "include/common/capture.h",
        "include/common/device.h",
        "include/common/flat_hash.h",
        "include/common/instrumentation.h",
        "include/common/no_init.h",
        "include/common/profiler_export.h",
        "include/common/profiler_macros.h",
        "include/common/profiler_strings.h",
        "include/common/session.h",
        "include/common/small_vector.h",
        "include/native/analysis/hotspot_report.h",
        "include/native/analysis/statistical_analyzer.h",
        "include/native/core/profiler_interface.h",
        "include/native/core/profiler_lock.h",
        "include/native/core/profiler_options.h",
        "include/native/core/profiler_status.h",
        "include/native/exporters/xplane/xplane.h",
        "include/native/memory/memory_tracker.h",
        "include/native/memory/scoped_memory_debug_annotation.h",
        "include/native/session/profiler.h",
        "include/native/session/profiler_report.h",
        "include/native/tracing/traceme.h",
        "include/native/tracing/traceme_encode.h",
        "include/native/tracing/traceme_recorder.h",
        "include/bespoke/common/record_function.h",
    ],
    prefix = "include",
    strip_prefix = strip_prefix.from_pkg("include"),
)

pkg_files(
    name = "profiler_installed_libs",
    srcs = [":Profiler"],
    prefix = "lib",
)

pkg_tar(
    name = "profiler_pkg_tar",
    srcs = [
        ":profiler_installed_hdrs",
        ":profiler_installed_libs",
    ],
)

pkg_install(
    name = "install",
    srcs = [
        ":profiler_installed_hdrs",
        ":profiler_installed_libs",
    ],
)
