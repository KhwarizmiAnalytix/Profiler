# =============================================================================
# Profiler library (matches CMakeLists.txt backend splits)
# =============================================================================
load("//bazel:profiler.bzl", "profiler_copts", "profiler_defines", "profiler_linkopts")

package(default_visibility = ["//visibility:public"])

# KINETO backend: bespoke/base, bespoke/kineto, bespoke/common (no unwind)
_KINETO_BACKEND_SRCS = glob(
    [
        "Profiler/kineto_*.cpp",
        "Profiler/kineto/**/*.cpp",
        "Profiler/bespoke/kineto/**/*.cpp",
        "Profiler/bespoke/common/**/*.cpp",
        "Profiler/bespoke/base/**/*.cpp",
    ],
    exclude = [
        "Profiler/bespoke/common/unwind/**/*.cpp",
        "Testing/**",
    ],
    allow_empty = True,
)

# ITT backend (when PROFILER_ENABLE_ITT and not KINETO): base + common + itt.
# Profiler/bespoke/kineto/kineto_shim.{h,cpp} is included even though this isn't the Kineto backend:
# Profiler/bespoke/common/collection.{h,cpp} #include "bespoke/kineto/kineto_shim.h" unconditionally
# (matches CMakeLists.txt).
# profiler_kineto.{h,cpp} is also included: it is the shared enableProfiler/
# disableProfiler orchestration layer for every backend (Kineto, ITT, NVTX,
# PRIVATEUSE1), not just Kineto -- its ITT dispatch branch is internally
# guarded by #if PROFILER_HAS_ITT and does not touch libkineto.
# kineto_client_interface.* is Kineto-ondemand-only (its body is wholly
# `#if PROFILER_HAS_KINETO`) but is harmlessly inert without it.
_ITT_BACKEND_SRCS = glob(
    [
        "Profiler/bespoke/base/**/*.cpp",
        "Profiler/bespoke/common/**/*.cpp",
        "Profiler/bespoke/itt/**/*.cpp",
        "Profiler/bespoke/kineto/kineto_shim.cpp",
        "Profiler/bespoke/kineto/profiler_kineto.cpp",
        "Profiler/bespoke/kineto/kineto_client_interface.cpp",
    ],
    exclude = [
        "Profiler/bespoke/common/unwind/**/*.cpp",
        "Testing/**",
    ],
    allow_empty = True,
)

_KINETO_BACKEND_HDRS = glob(
    [
        "Profiler/kineto_*.h",
        "Profiler/kineto/**/*.h",
        "Profiler/bespoke/kineto/**/*.h",
        "Profiler/bespoke/common/**/*.h",
        "Profiler/bespoke/base/**/*.h",
    ],
    exclude = ["Testing/**"],
    allow_empty = True,
)

_ITT_BACKEND_HDRS = glob(
    [
        "Profiler/bespoke/base/**/*.h",
        "Profiler/bespoke/common/**/*.h",
        "Profiler/bespoke/itt/**/*.h",
        "Profiler/bespoke/kineto/kineto_shim.h",
        "Profiler/bespoke/kineto/profiler_kineto.h",
        "Profiler/bespoke/kineto/kineto_client_interface.h",
    ],
    exclude = ["Testing/**"],
    allow_empty = True,
)

filegroup(
    name = "profiler_hdrs",
    srcs = glob(
        [
            "Profiler/*.h",
            "Profiler/**/*.h",
        ],
        exclude = [
            "Testing/**",
            "Profiler/native/**",
            "Profiler/bespoke/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "profiler_srcs",
    srcs = glob(
        [
            "Profiler/*.cpp",
            "Profiler/**/*.cpp",
        ],
        exclude = [
            "Profiler/native/**/*.cpp",
            "Profiler/bespoke/**",
            "Profiler/kineto_*.cpp",
            "Profiler/kineto/**/*.cpp",
            "Testing/**",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "Profiler",
    srcs = [
        ":profiler_srcs",
    ] + glob(["Profiler/native/**/*.cpp"], exclude = ["Testing/**"], allow_empty = True) + select({
        "//bazel:enable_itt": _ITT_BACKEND_SRCS,
        "//conditions:default": _KINETO_BACKEND_SRCS,
    }),
    hdrs = [
        ":profiler_hdrs",
    ] + glob(["Profiler/native/**/*.h", "Profiler/native/**/*.hxx"], exclude = ["Testing/**"], allow_empty = True) + select({
        "//bazel:enable_itt": _ITT_BACKEND_HDRS,
        "//conditions:default": _KINETO_BACKEND_HDRS,
    }),
    copts = profiler_copts(),
    defines = profiler_defines() + select({
        "//bazel:shared_libs": ["PROFILER_SHARED_DEFINE", "PROFILER_BUILDING_DLL"],
        "//conditions:default": ["PROFILER_STATIC_DEFINE"],
    }),
    includes = [
        "Profiler",
    ],
    linkopts = profiler_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    deps = [
        "@fmt//:fmt",
    ] + select({
        "//bazel:enable_itt": ["@ittapi//:ittnotify"],
        "//conditions:default": ["@kineto//:kineto"],
    }) + select({
        "//bazel:enable_cuda": ["@local_config_cuda//:cuda"],
        "//conditions:default": [],
    }) + select({
        "//bazel:enable_hip": ["@local_config_hip//:hip"],
        "//conditions:default": [],
    }),
    # native/core/profiler_factory.h's registered profilers (host_tracer_factory,
    # python_tracer_factory, gpu_tracer_factory) self-register via static-init --
    # no other code references a symbol in those translation units. Bazel links this
    # target as a static archive (see linkstatic above); without alwayslink, the linker
    # drops those objects and host/GPU tracing never starts. CMake's shared-library
    # build doesn't hit this since every object file in a .so is linked.
    alwayslink = True,
)
